# Configuração do coverage para a suíte do backend.
#
# Fica em backend/ (e não no pyproject da raiz) porque scripts/coverage.sh
# executa a partir de backend/ — assim o arquivo é detectado sem flags extras.
#
# A cobertura mede CÓDIGO DE APLICAÇÃO: migrations, testes e entrypoints do
# framework ficam de fora para o percentual não ser inflado artificialmente.

[run]
source = .
omit =
    */migrations/*
    */tests.py
    */tests/*
    manage.py
    */wsgi.py
    */asgi.py

[report]
show_missing = true
skip_covered = false
