# ⚠️ ATENÇÃO: Este é um TEMPLATE. NUNCA comite credenciais reais.
# Copie para .env e preencha com valores seguros para o ambiente.
# Em produção: SECRET_KEY deve ser longa e aleatória, DEBUG=False.
SECRET_KEY=change-me-to-a-very-long-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

MYSQL_DATABASE=m2shop
MYSQL_USER=m2shop
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

DOMAIN=localhost
