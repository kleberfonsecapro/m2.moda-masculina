# ⚠️ ATENÇÃO: Este é um TEMPLATE. NUNCA comite credenciais reais.
# Copie para .env e preencha com valores seguros para o ambiente.
#
# --- Django ---
# SECRET_KEY: gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-very-long-random-key
# Em produção SEMPRE DEBUG=False (ativa SSL redirect, HSTS e cookies secure)
DEBUG=True
# Em produção: m2moda.com.br,www.m2moda.com.br (ou m2moda.duckdns.org em testes)
# Para desenvolvimento local com HTTPS (mkcert): adicione localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
# Origem real usada em links de email (verificação e password reset)
# Para desenvolvimento HTTPS local: adicione https://localhost:8443,https://127.0.0.1:8443
# Para acesso via IP na rede local: adicione https://SEU_IP_LOCAL:8443
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://localhost:8443,https://127.0.0.1:8443
# URL absoluta da loja (usada em emails de verificação/reset)
SITE_URL=http://localhost:8080
# Senha do superusuário "admin" criado pelo seed (obrigatória em produção)
ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# --- Banco de dados (MySQL) ---
MYSQL_DATABASE=m2shop
MYSQL_USER=m2shop
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password
MYSQL_HOST=db
MYSQL_PORT=3306

# --- Email SMTP (opcional — sem valores usa o backend de console) ---
# O site público não tem contas de cliente (sem verificação/reset de email).
# O SMTP só é necessário se você quiser que o Django envie e-mails de forma real.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.seudohosting.com.br
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=contato@seudominio.com.br
EMAIL_HOST_PASSWORD=change-me-to-the-mailbox-password

# --- Domínio da loja (uso documental/scripts) ---
DOMAIN=m2moda.com.br
